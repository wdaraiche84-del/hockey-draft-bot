# Jeton du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Serveurs autorisés, séparés par des virgules (ex. : 111111111111111111,222222222222222222).
# Le bot quitte tout seul un serveur qui n'est pas dans cette liste.
GUILD_IDS=
# Dossier de la base du draft et des sauvegardes (vide = à côté du bot).
# Sur Railway, inutile : le volume est détecté tout seul.
DATA_DIR=
