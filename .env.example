# Jeton du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Dossier de la base du draft et des sauvegardes (vide = à côté du bot).
# Sur Railway, inutile : le volume est détecté tout seul.
DATA_DIR=
# Facultatif : le compte SHM du bot, pour annoncer les transactions SHM automatiquement.
# Le commissaire de chaque ligue ajoute ce compte comme membre de sa ligue, sans équipe.
SHM_USERNAME=
SHM_PASSWORD=
# Facultatif : la clé secrète convenue avec les admins de SHM pour que Cloudflare laisse passer le bot.
# Envoyée dans l'en-tête X-Bot-Key de chaque requête. Lettres, chiffres et signes simples seulement.
SHM_BOT_KEY=
